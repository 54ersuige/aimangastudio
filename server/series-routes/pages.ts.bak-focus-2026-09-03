          dialogue: { type: 'string', description: '面向读者的旁白或对话文字（1-2句），如"陈默推开玻璃门"或"「终于到了。」"。必填，不可为空。' },
          camera: { type: 'string', description: '镜头景别+角度，取值：远景/全景/中景/中近景/近景/特写，可加角度后缀（如"中景，轻微仰角"）。' },
