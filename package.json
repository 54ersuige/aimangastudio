{
  "name": "aimangastudio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run server:dev",
    "server:dev": "cd server && npm run dev",
    "server:start": "cd server && npm run start",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "npm --prefix server run typecheck",
    "check": "npm run typecheck && npm run typecheck:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "cd server && npm install"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
