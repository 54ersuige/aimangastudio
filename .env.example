# AI Manga Studio 本地部署配置文件
# 复制本文件为 .env 并填入你的 API 密钥

# ========================= 文字生成模型配置 =========================
# 可选 provider: gemini | deepseek | agnes | openai-compatible
TEXT_PROVIDER=agnes
TEXT_MODEL=agnes-2.5-flash
TEXT_API_KEY=your_agnes_api_key_here
TEXT_BASE_URL=https://apihub.agnes-ai.cn/v1
TEXT_TIMEOUT=60000
# TEXT_EXTRA_PARAMS={"temperature":0.7}

# ========================= 图片生成模型配置 =========================
# 可选 provider: gemini | step | minimax | agnes | openai-compatible
IMAGE_PROVIDER=agnes
IMAGE_MODEL=agnes-image-2.1-flash
IMAGE_API_KEY=your_agnes_api_key_here
IMAGE_BASE_URL=https://apihub.agnes-ai.cn/v1
IMAGE_TIMEOUT=120000
# IMAGE_EXTRA_PARAMS={}

# 或者使用阶跃星辰 step-image-edit-2：
# IMAGE_PROVIDER=step
# IMAGE_MODEL=step-image-edit-2
# IMAGE_API_KEY=your_step_api_key_here
# IMAGE_BASE_URL=https://api.stepfun.com/v1

# ========================= 视频生成模型配置（Agnes 免费） =========================
# 视频生成目前走 Agnes 异步任务接口（POST /videos/generations）。
# 只要上面 IMAGE_PROVIDER 设为 agnes 即可免费生成视频。
# Agnes 视频专用参数（透传进 extraParams，可选）：
#   {"duration": 5, "mode": "std"}
#
# 切换回 Gemini Veo 视频：请保留下面的 GEMINI_API_KEY 并在前端视频页里选 "Veo 3"。
GEMINI_API_KEY=your_gemini_api_key_here