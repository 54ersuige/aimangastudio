# AI Manga Studio 本地部署配置文件
# 复制本文件为 .env 并填入你的 API 密钥
#
# 配置优先级（高 → 低）：
#   1. 界面「模型配置」保存的 server/runtime-config.json（本地运行时文件，不入库）
#   2. 本文件 .env
#   3. 代码内置默认值（Agnes）

# ========================= 文字生成模型配置 =========================
# 可选 provider: gemini | deepseek | agnes | openai-compatible
TEXT_PROVIDER=agnes
TEXT_MODEL=agnes-2.5-flash
TEXT_API_KEY=your_agnes_api_key_here
TEXT_BASE_URL=https://apihub.agnes-ai.cn/v1
TEXT_TIMEOUT=180000
# TEXT_EXTRA_PARAMS={"temperature":0.7}

# ========================= 图片生成模型配置 =========================
# 可选 provider: gemini | step | minimax | agnes | openai-compatible
IMAGE_PROVIDER=agnes
IMAGE_MODEL=agnes-image-2.1-flash
IMAGE_API_KEY=your_agnes_api_key_here
IMAGE_BASE_URL=https://apihub.agnes-ai.cn/v1
IMAGE_TIMEOUT=240000
# IMAGE_EXTRA_PARAMS={}

# 或者切换其他 provider 示例：
# DeepSeek 文字：  TEXT_PROVIDER=deepseek / TEXT_MODEL=deepseek-v4-flash / TEXT_BASE_URL=https://api.deepseek.com
# Minimax 图片：   IMAGE_PROVIDER=minimax / IMAGE_MODEL=image-01-live / TEXT_BASE_URL=https://api.minimaxi.chat/v1
# 阶跃星辰图片：   IMAGE_PROVIDER=step / IMAGE_MODEL=step-image-edit-2 / TEXT_BASE_URL=https://api.stepfun.com/v1
# Gemini（文字或图片）：额外配置 GEMINI_API_KEY=your_gemini_api_key_here

# ========================= 视觉（多模态）模型配置（可选） =========================
# 2026-09-03：用于 limb-guard 自动巡检「多胳膊/多手指/肢体伪影」。
# 默认 VISION_ENABLED 未设置时为 false —— 不启用 limb-guard，主流程不受影响。
# 启用后：每张角色参考图 / 分镜图落盘前，由视觉模型打一次分，异常则自动 inpaint。
# provider 可选：gemini | minimax | agnes | openai-compatible
#VISION_ENABLED=false
#VISION_PROVIDER=gemini
#VISION_MODEL=gemini-2.5-flash
#VISION_API_KEY=
#VISION_BASE_URL=
#VISION_TIMEOUT=30000
#VISION_EXTRA_PARAMS={}
